{
  "threshold": 0.8,
  "highBelow": 0.3,
  "maxChangedLines": 1000,
  "maxChangedFiles": 25,
  "notCountedForSize": [
    "**/pnpm-lock.yaml",
    "**/package-lock.json",
    "**/yarn.lock",
    "**/bun.lock",
    "**/*.lock",
    "**/*.snap",
    "**/*-snapshots/**"
  ],
  "sensitive": [
    ".github/**",
    "actions/review-gate/**",
    "**/.coderabbit.y*ml",
    "**/*auth*",
    "**/*auth*/**",
    "**/*secret*",
    "**/*secret*/**",
    "**/.env*",
    "**/*.pem",
    "**/*.key",
    "**/*.age",
    "**/encrypted_*",
    "**/private_*",
    "**/run_once_*",
    "**/run_onchange_*",
    "**/run_before_*",
    "**/run_after_*",
    "**/install*.sh",
    "**/bootstrap*",
    "**/migrations/**",
    "**/drizzle/**",
    "**/*.sql",
    "**/Dockerfile*",
    "**/wrangler.*",
    "**/railway.*",
    ".railway/**",
    "pulumi/**",
    "policies/**",
    "**/*.hcl",
    "**/*.tf",
    "apps.json"
  ]
}
