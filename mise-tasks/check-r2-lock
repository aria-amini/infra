#!/usr/bin/env bash
#MISE description="Check that R2 refuses a second conditional write, which state locking relies on"
set -euo pipefail

# Take the keys from the environment (CI), or prompt for them.
key=${AWS_ACCESS_KEY_ID:-}
secret=${AWS_SECRET_ACCESS_KEY:-}
[ -n "$key" ] || { read -rsp "R2 state access key ID: " key && echo >&2; }
[ -n "$secret" ] || { read -rsp "R2 state secret access key: " secret && echo >&2; }
url="$AWS_ENDPOINT_URL_S3/$STATE_BUCKET/.lock-check-$$"
# The key goes to curl on stdin, so it never shows up in a process listing.
curl() { printf 'user = "%s:%s"\n' "$key" "$secret" | command curl -K - "$@"; }
put() {
	curl -s -o /dev/null -w '%{http_code}' -X PUT --data-binary probe -H 'If-None-Match: *' \
		--aws-sigv4 'aws:amz:auto:s3' "$url"
}

first=$(put)
second=$(put)
curl -s -o /dev/null -X DELETE --aws-sigv4 'aws:amz:auto:s3' "$url"
echo "first write: $first, second write: $second"
if [ "$first" != 200 ] || [ "$second" != 412 ]; then
	echo "R2 did not refuse the second write; don't rely on use_lockfile" >&2
	exit 1
fi
echo "locking works"
